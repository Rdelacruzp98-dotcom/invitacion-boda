/* FLORES */

.floral{
position:absolute;
width:170px;
height:210px;
opacity:.45;
pointer-events:none;
}

.floral.left{left:-30px;top:20px}
.floral.right{right:-30px;bottom:20px;transform:scaleX(-1)}

.stem{
position:absolute;
width:3px;
height:175px;
background:var(--blueDark);
left:80px;
top:20px;
transform:rotate(20deg);
border-radius:50%;
}

.leaf{
position:absolute;
width:38px;
height:18px;
background:var(--blue);
border-radius:100% 0 100% 0;
}

.leaf1{left:48px;top:55px;transform:rotate(-30deg)}
.leaf2{left:90px;top:82px;transform:rotate(30deg)}
.leaf3{left:40px;top:115px;transform:rotate(-25deg)}
.leaf4{left:92px;top:140px;transform:rotate(25deg)}

.flower{
position:absolute;
width:28px;
height:28px;
border-radius:50%;
background:var(--blue2);
box-shadow:
0 -10px 0 var(--blue2),
10px 0 0 var(--blue2),
0 10px 0 var(--blue2),
-10px 0 0 var(--blue2);
}

.flower:after{
content:"";
position:absolute;
width:8px;
height:8px;
background:var(--brown2);
border-radius:50%;
top:10px;
left:10px;
}

.flower1{top:25px;left:72px}
.flower2{top:92px;left:110px;transform:scale(.7)}
.flower3{top:145px;left:45px;transform:scale(.6)}

